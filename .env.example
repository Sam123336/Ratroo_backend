# PostgreSQL/PostGIS connection used by the API.
DATABASE_URL=postgresql://user:password@host:5432/transit_db
DB_SSL=true
DB_SYNCHRONIZE=false

# Required at API boot. Use at least 32 random characters.
JWT_SECRET=replace-with-a-long-random-secret

# Protects internal ingestion endpoints.
INTERNAL_INGESTION_API_KEY=replace-with-a-random-api-key

# Optional AI integrations.
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional background ingestion. A long-lived worker is required when enabled.
REDIS_URL=
CRON_SECRET=
PROVIDER_SYNC_ENABLED=false

# Leave unset normally. Vercel automatically uses /tmp/ratroo-bmtc-cache.
BMTC_CACHE_DIR=
