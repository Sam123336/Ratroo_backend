{
  "name": "@transit/api",
  "version": "1.0.0",
  "description": "Multi-provider normalized transit backend API with PostGIS",
  "private": true,
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "start:watch": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "node --require ts-node/register --test \"src/**/*.spec.ts\"",
    "migrate": "ts-node -r tsconfig-paths/register src/database/migrate.ts up",
    "migrate:down": "ts-node -r tsconfig-paths/register src/database/migrate.ts down",
    "migrate:status": "ts-node -r tsconfig-paths/register src/database/migrate.ts status",
    "migrate:create": "ts-node -r tsconfig-paths/register src/database/migrate.ts create",
    "gen:module": "node scripts/generate-module.js",
    "timetables:interpolate": "ts-node -r tsconfig-paths/register src/scripts/interpolate-timetables.ts",
    "timetables:curated": "ts-node -r tsconfig-paths/register src/scripts/import-curated-timetables.ts",
    "routes:prune": "ts-node -r tsconfig-paths/register src/scripts/prune-experimental-routes.ts",
    "stops:repair": "ts-node -r tsconfig-paths/register src/scripts/repair-stop-coordinates.ts",
    "routes:repair-endpoints": "ts-node -r tsconfig-paths/register src/scripts/repair-wbbus-route-endpoints.ts",
    "providers:seed": "ts-node -r tsconfig-paths/register src/scripts/seed-providers.ts",
    "wbbus:backfill-times": "ts-node -r tsconfig-paths/register src/scripts/backfill-wbbus-times.ts",
    "stops:prune-garbage": "ts-node -r tsconfig-paths/register src/scripts/prune-garbage-stops.ts",
    "bmtc:ingest": "ts-node -r tsconfig-paths/register src/scripts/ingest-bmtc.ts",
    "bmtc:promote": "ts-node -r tsconfig-paths/register src/scripts/promote-bmtc.ts",
    "transit:project": "ts-node -r tsconfig-paths/register src/scripts/project-transit.ts",
    "regions:build-polygons": "ts-node -r tsconfig-paths/register src/scripts/build-region-polygons.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/sequelize": "^11.0.1",
    "@nestjs/swagger": "^7.2.0",
    "axios": "^1.6.5",
    "bullmq": "^6.0.8",
    "cheerio": "^1.0.0-rc.12",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.4.2",
    "google-auth-library": "^11.0.2",
    "groq-sdk": "^1.5.0",
    "ioredis": "^6.0.0",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "@types/pg": "^8.11.0",
    "prettier": "^3.2.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  }
}
